        "code": {
          "language": "tsx",
          "content": "import React from 'react';\nimport {Stage, Title, Body, Card, Formula, Scenes, lessonLength} from './kit';\n\nconst scenes = [\n{voice: \"scene-1\", frames: 150, content: (<Stage eyebrow={\"立方体体积：V=a³（8秒速览）\"}><Title x={120} y={150} w={1500} size={72}>{\"认识立方体体积\"}</Title><Body x={120} y={300} w={1200} size={38}><p>\"立方体的长、宽、高都等于边长 a\"</p><p>\"体积 = 长×宽×高 = a×a×a\"</p><p>\"公式：V = a³\"</p></Body><Card x={120} y={560} w={900} title={\"核心公式\"}><Formula>{\"V = a^3\"}</Formula></Card></Stage>)},\n{voice: \"scene-2\", frames: 150, content: (<Stage eyebrow={\"立方体体积：V=a³（8秒速览）\"}><Title x={120} y={150} w={1500} size={72}>{\"代入 a=3 计算\"}</Title><Body x={120} y={300} w={1200} size={38}><p>\"取边长 a = 3\"</p><p>\"则 V = 3³ = 3×3×3 = 27\"</p><p>\"单位随边长，如 3 cm 对应 27 cm³\"</p></Body><Card x={120} y={560} w={900} title={\"核心公式\"}><Formula>{\"V = 3^3 = 27\"}</Formula></Card></Stage>)},\n];\n\nexport const LESSON = {durationInFrames: lessonLength(scenes), fps: 30, width: 1920, height: 1080};\n\nexport function Lesson() {\n  return <Scenes scenes={scenes} />;\n}\n"
