          "content": "import React from 'react';\nimport {Stage, Title, Body, Card, Formula, Scenes, lessonLength} from './kit';\n\nconst scenes = [\n{voice: \"scene-1\", frames: 150, content: (<Stage eyebrow={\"立方体体积公式 V=a³（8秒速览）\"}><Title x={120} y={150} w={1500} size={72}>{\"认识立方体体积\"}</Title><Body x={120} y={300} w={1200} size={38}><p>\"立方体：长=宽=高=边长 a\"</p><p>\"体积=底面积×高=a²×a\"</p><p>\"公式：V=a³\"</p></Body><Card x={120} y={560} w={900} title={\"核心公式\"}><Formula>{\"V = a^3\"}</Formula></Card></Stage>)},\n{voice: \"scene-2\", frames: 150, content: (<Stage eyebrow={\"立方体体积公式 V=a³（8秒速览）\"}><Title x={120} y={150} w={1500} size={72}>{\"例题：a=3 时\"}</Title><Body x={120} y={300} w={1200} size={38}><p>\"代入：V=3³\"</p><p>\"计算：3×3×3=27\"</p><p>\"结论：V=27\"</p></Body><Card x={120} y={560} w={900} title={\"核心公式\"}><Formula>{\"V = 3^3 = 27\"}</Formula></Card></Stage>)},\n];\n\nexport const LESSON = {durationInFrames: lessonLength(scenes), fps: 30, width: 1920, height: 1080};\n\nexport function Lesson() {\n  return <Scenes scenes={scenes} />;\n}\n"
