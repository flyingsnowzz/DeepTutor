# Static Vue 3 frontend with same-origin FastAPI and WebSocket proxy.
# Replace example.com, certificate paths, and /srv/deeptutor/web-vue3/dist.
# Keep this map in nginx's http context (sites-enabled files normally are).
map $http_upgrade $deeptutor_connection_upgrade {
    default upgrade;
    ''      close;
}

upstream deeptutor_api {
    server 127.0.0.1:8001;
    keepalive 16;
}

server {
    listen 80;
    server_name example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name example.com;
    if ($host != example.com) { return 421; }
    root /srv/deeptutor/web-vue3/dist;
    index index.html;

    ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 100m;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Deeptutor-Frontend-Host $http_host;

    location /api/ {
        proxy_pass http://deeptutor_api;
        proxy_buffering off;
        proxy_read_timeout 900s;
    }

    location /ws {
        proxy_pass http://deeptutor_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Deeptutor-Frontend-Host $http_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $deeptutor_connection_upgrade;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
    }

    location /files/ {
        proxy_pass http://deeptutor_api;
        proxy_buffering off;
        proxy_read_timeout 900s;
    }

    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
