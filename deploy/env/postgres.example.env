# DeepTutor platform PostgreSQL + object storage environment template.
# Copy to deploy/env/postgres.env (untracked) or export into your shell.
# Postgres is the sole relational system of record from T2; SQLite exists
# only as a one-time ETL source.

# --- PostgreSQL 15+ (required for the SaaS/MCP/new-platform path) -----------
# asyncpg driver; create the database and role before running alembic upgrade.
DATABASE_URL=postgresql+asyncpg://deeptutor:deeptutor@127.0.0.1:5432/deeptutor

# Used by psql / pg_dump / pg_restore drills (libpq driver, no +asyncpg).
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=deeptutor
PGPASSWORD=deeptutor
PGDATABASE=deeptutor

# Alembic
ALEMBIC_CONFIG=alembic.ini

# --- S3-compatible object storage (artifacts; metadata stays in Postgres) ---
# MinIO locally; any S3-compatible cloud service in production.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=deeptutor-dev
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
# Auto-create the bucket only for local endpoints (LocalStack/MinIO).
S3_AUTO_CREATE_BUCKET=1
S3_PRESIGN_EXPIRES_SECONDS=900

# --- Redis: coordination / queue / cache only, never authoritative storage --
REDIS_URL=redis://127.0.0.1:6379/0

# --- Local services ----------------------------------------------------------
# docker compose -f deploy/docker-compose.postgres-minio.yml --profile minio up -d

# --- T3 auth/quota storage uses the same DATABASE_URL -------------------------
# The cloud app migrates to head (0003_auth_quota): accounts, refresh tokens,
# quota counters/ledger, audit_events and owner_isolation RLS policies.
# Production connections use the restricted deeptutor_app role
# (deploy/postgres/init/01_app_role.sql); migrations use the table owner.
