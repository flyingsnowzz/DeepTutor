# DeepTutor platform PostgreSQL + object storage environment template.
# Copy to deploy/env/postgres.env (untracked) or export into your shell.
# Apply migrations with the table-owning role, then apply the auth role SQL.
# Enable the runtime flags only after final data import and cutover checks.

# --- PostgreSQL 15+ (required for the SaaS/MCP/new-platform path) -----------
# asyncpg driver; create the database and role before running alembic upgrade.
# Migration/ETL connection (run separately; never use for the Web runtime):
# DATABASE_URL=postgresql+asyncpg://migration_owner:secret@postgres:5432/deeptutor_prod
# Runtime learning-data connection; row-level security applies:
DATABASE_URL=postgresql+asyncpg://deeptutor_app:replace-me@127.0.0.1:5432/deeptutor_prod
# Credential connection; limited account tables and BYPASSRLS for pre-login lookup:
AUTH_DATABASE_URL=postgresql+asyncpg://deeptutor_auth:replace-me@127.0.0.1:5432/deeptutor_prod
# DEEPTUTOR_ACCOUNT_BACKEND=postgres
# DEEPTUTOR_STORAGE_BACKEND=postgres

# Used by psql / pg_dump / pg_restore drills (libpq driver, no +asyncpg).
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=deeptutor
PGPASSWORD=replace-me
PGDATABASE=deeptutor_prod

# Alembic
ALEMBIC_CONFIG=alembic.ini

# --- S3-compatible object storage (artifacts; metadata stays in Postgres) ---
# MinIO locally; any S3-compatible cloud service in production.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=deeptutor-dev
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
# Auto-create the bucket only for local endpoints (LocalStack/MinIO).
S3_AUTO_CREATE_BUCKET=1
S3_PRESIGN_EXPIRES_SECONDS=900

# --- Redis: coordination / queue / cache only, never authoritative storage --
REDIS_URL=redis://127.0.0.1:6379/0

# --- Local services ----------------------------------------------------------
# docker compose -f deploy/docker-compose.postgres-minio.yml --profile minio up -d

# Create the clean target database, run Alembic, then apply 01_app_role.sql and
# 02_auth_role.sql to that same database.
# Set independent random passwords for deeptutor_app and deeptutor_auth.
