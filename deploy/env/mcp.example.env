# DeepTutor MCP / platform local development environment template
# Copy to a local untracked env file or export variables in your shell.
# Do not put real secrets in Git, SKILL.md, mcp.json, logs, or screenshots.

# PostgreSQL (required from the SaaS/MCP runtime path)
DATABASE_URL=postgresql+asyncpg://deeptutor:deeptutor@127.0.0.1:5432/deeptutor

# S3-compatible object storage / MinIO
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=deeptutor-dev
S3_ACCESS_KEY_ID=${DEEPTUTOR_S3_KEY}
S3_SECRET_ACCESS_KEY=${DEEPTUTOR_S3_SECRET}
S3_PRESIGN_EXPIRES_SECONDS=900

# Redis is optional for local development; required for multi-instance coordination
REDIS_URL=redis://127.0.0.1:6379/0

# External caller token (HTTP transport). stdio local development may use a dev token.
DEEPTUTOR_TOKEN=replace-with-local-dev-token

# Runtime limits
MCP_REQUEST_MAX_BYTES=1048576
MCP_OUTPUT_MAX_CHARS=8000
MCP_JOB_DEFAULT_TIMEOUT_SECONDS=900
MCP_MEDIA_JOB_TIMEOUT_SECONDS=1800
MCP_RATE_LIMIT_PER_MINUTE=120

# --- T3 cloud HTTP service ----------------------------------------------------
# Transport
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8001
DEEPTUTOR_PUBLIC_BASE_URL=https://mcp.deeptutor.example.com

# Auth: generate with `openssl rand -hex 32`; never reuse across environments.
DEEPTUTOR_JWT_SECRET=replace-with-64-hex-chars
DEEPTUTOR_TOKEN_ISSUER=deeptutor
DEEPTUTOR_ACCESS_TTL_SECONDS=3600
DEEPTUTOR_REFRESH_TTL_DAYS=30
# Local development only: allows an insecure fixed secret without DEEPTUTOR_JWT_SECRET.
DEEPTUTOR_ALLOW_DEV_SECRET=0

# Limits / metering
MCP_REQUEST_MAX_BYTES=1048576
MCP_ARTIFACT_MAX_BYTES=52428800
MCP_RATE_LIMIT_MCP_PER_MINUTE=120
MCP_RATE_LIMIT_AUTH_PER_MINUTE=20

# --- T4 teaching media --------------------------------------------------------
# Use the LLM-backed reading answerer when model credentials are configured;
# unset/false keeps the deterministic citation retriever (offline trial mode).
DEEPTUTOR_READING_LLM=0
# Media render runtimes (video_lesson needs node/npm + ffmpeg; math_animator
# additionally needs manim>=0.19 and a LaTeX distribution). capabilities_list
# reports readiness; missing deps return CAPABILITY_UNAVAILABLE.
