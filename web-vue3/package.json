{
  "name": "deeptutor-web-vue3",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3783",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "routes:status": "node ./scripts/route-status.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 3783",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:acceptance": "playwright test --config=playwright.acceptance.config.ts",
    "test:server": "node --test tests/server/*.test.mjs"
  },
  "dependencies": {
    "@tiptap/extension-link": "^3.33.0",
    "@tiptap/extension-task-item": "^3.33.0",
    "@tiptap/extension-task-list": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "@tiptap/vue-3": "^3.33.0",
    "chart.js": "^4.6.1",
    "dompurify": "^3.4.17",
    "epubjs": "^0.3.93",
    "marked": "^18.1.3",
    "mermaid": "^11.17.2",
    "pdfjs-dist": "^6.2.108",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.15.3",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^31.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^5.1.0",
    "vue-tsc": "^2.2.12"
  }
}
